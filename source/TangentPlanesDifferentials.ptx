</point>
<point at="cs-fP0" p="(6.6,1.0)" fill="#0072B2"/>
<point at="cs-fP" p="(7.75,1.0)" fill="#D55E00"/>
<label at="cs-x-label" anchor="(3.62,0.1)" alignment="e">
<m>x</m>
</label>
<label at="cs-y-label" anchor="(-0.18,2.3)" alignment="w">
<m>y</m>
</label>
