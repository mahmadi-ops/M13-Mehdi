<m>z</m>
</label>
<label at="cs-header1" anchor="(-0.6,3.35)" alignment="e">
<m>\mathbf u = u_1\,\mathbf i + u_2\,\mathbf j</m>
</label>
<label at="cs-header2" anchor="(-0.6,2.9)" alignment="e">
<m>\mathbf u\,ds = u_1\,ds\,\mathbf i + u_2\,ds\,\mathbf j,\quad |\mathbf u\,ds| = ds</m>
</label>
<label at="cs-u1-label" anchor="(1.0,0.8)" alignment="s" color="#E69F00">
