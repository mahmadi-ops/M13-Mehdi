          forget plot]
  ({x},{0.5},{2.8875 - 0.25*x^2});
% intersection curve with x = x0 (black)
\addplot3[very thick, black, domain=-2:2, samples=41, samples y=0,
          forget plot]
  ({0.5},{x},{2.9375 - 0.45*x^2});
% tangent line at P0 in the plane y = y0 (blue)
\addplot3[very thick, blue!70!black, domain=-1.4:1.4, samples=2, samples y=0,
