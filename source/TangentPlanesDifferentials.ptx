  ({0.5+x},{0.5},{2.825 - 0.25*x});
% tangent line at P0 in the plane x = x0 (dark red)
\addplot3[very thick, purple!70!black, domain=-1.4:1.4, samples=2, samples y=0,
          forget plot]
  ({0.5},{0.5+x},{2.825 - 0.45*x});
% the normal vector n (magenta)
\draw[-stealth, magenta, very thick]
  (axis cs:0.5,0.5,2.825) -- (axis cs:0.75,0.95,3.83);
