<?xml version="1.0" encoding="utf-8"?>
<section xml:id="section-4" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Sample Graphs</title>
    <p>
    Here we will include some interactive graphs to decide which one of 
  them is what we want to use. 
    </p>
    
<interactive xml:id="interactive-hyperboloid-slices" iframe="hyperboloid-slices.html" width="100%" aspect="7:6">
  <instructions>
    Use the buttons to slice the surface <m>x^2+y^2-z^2=1</m> with planes
    <m>x=c</m>, <m>y=c</m>, or <m>z=c</m>, and drag the slider to vary <m>c</m>.
  </instructions>
</interactive>

<figure xml:id="fig-hyperboloid-slices-video">
  <caption>
    Slicing <m>x^2 + y^2 - z^2 = 1</m> with planes <m>z = c</m>,
    <m>x = c</m>, and <m>y = c</m>.
  </caption>
  <video xml:id="video-hyperboloid-slices"
         source="videos/hyperboloid_slices_manim.mp4"
         width="100%" aspect="16:9"/>
</figure>

</section>