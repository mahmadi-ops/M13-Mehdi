        </coordinates>
        <annotations>
          <annotation ref="figure" text="The trace in the plane z = 0: an ellipse, the smallest horizontal trace">
            <annotation ref="trace-z" text="In the plane z equals 0, the trace x squared over 4 plus y squared over 9 equals 1 is an ellipse with semi-axes 2 and 3, the smallest horizontal trace of the surface"/>
          </annotation>
        </annotations>
      </diagram>
    </prefigure>
