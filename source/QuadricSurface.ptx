  }
  \fill[oiblue!10] (0,0) rectangle (19.1,-1.1);
  \foreach \yy in {0,-1.1,-5.1,-9.1,-13.1,-17.1,-21.1,-25.1}
    \draw[black!45, line width=0.4pt] (0,\yy) -- (19.1,\yy);
  \foreach \xx in {0,3,5.9,10.3,14.7,19.1}
    \draw[black!45, line width=0.4pt] (\xx,0) -- (\xx,-25.1);
  \node[font=\bfseries\large] at (1.5,-0.55) {Equation};
  \node[font=\bfseries\large] at (4.45,-0.55) {Shape};
  \node[font=\bfseries\large, align=center] at (8.1,-0.55) {$x=c$ slices};
  \node[font=\bfseries\large, align=center] at (12.5,-0.55) {$y=c$ slices};
  \node[font=\bfseries\large, align=center] at (16.9,-0.55) {$z=c$ slices};
  \node[align=center, text width=2.7cm] at (1.5,-3.1) {\itshape elliptical\\ paraboloid\\[3pt]\upshape\small $\displaystyle z=\frac{x^2}{4}+\frac{y^2}{9}$};
  \begin{axis}[icon, at={(4.45cm,-3.1cm)}, anchor=center, xmin=-3.5,xmax=3.5,ymin=-5,ymax=5,zmin=-0.4,zmax=3]
    \addplot3[surfacestyle, domain=0:360, samples=19, y domain=0:1.6, samples y=12] ({2*y*cos(x)},{3*y*sin(x)},{y*y});
  \end{axis}
  \node[align=center, text width=4.1cm] at (8.1,-3.1) {\normalsize $z=\frac{c^2}{4}+\frac{y^2}{9}$\\[3pt]\itshape parabola\\[3pt]{\small\normalfont\color{black!55} opens up}};
  \node[align=center, text width=4.1cm] at (12.5,-3.1) {\normalsize $z=\frac{x^2}{4}+\frac{c^2}{9}$\\[3pt]\itshape parabola\\[3pt]{\small\normalfont\color{black!55} opens up}};
  \node[align=center, text width=4.1cm] at (16.9,-3.1) {\normalsize $\frac{x^2}{4}+\frac{y^2}{9}=c$\\[3pt]\itshape ellipse\\[3pt]{\small\normalfont\color{black!55} point $(0,0,0)$ if $c=0$}};
  \node[align=center, text width=2.7cm] at (1.5,-7.1) {\itshape hyperbolic\\ paraboloid\\[3pt]\upshape\small $\displaystyle z=\frac{x^2}{4}-\frac{y^2}{9}$};
  \begin{axis}[icon, at={(4.45cm,-7.1cm)}, anchor=center, xmin=-3.5,xmax=3.5,ymin=-5,ymax=5,zmin=-2.6,zmax=2.6]
    \addplot3[surfacestyle, domain=-3:3, samples=17, y domain=-4.5:4.5, samples y=19] ({x},{y},{x*x/4 - y*y/9});
  \end{axis}
  \node[align=center, text width=4.1cm] at (8.1,-7.1) {\normalsize $z=\frac{c^2}{4}-\frac{y^2}{9}$\\[3pt]\itshape parabola\\[3pt]{\small\normalfont\color{black!55} opens down}};
  \node[align=center, text width=4.1cm] at (12.5,-7.1) {\normalsize $z=\frac{x^2}{4}-\frac{c^2}{9}$\\[3pt]\itshape parabola\\[3pt]{\small\normalfont\color{black!55} opens up}};
  \node[align=center, text width=4.1cm] at (16.9,-7.1) {\normalsize $\frac{x^2}{4}-\frac{y^2}{9}=c$\\[3pt]\itshape hyperbola\\[3pt]{\small\normalfont\color{black!55} opens left--right;\\ two lines if $c=0$}};
  \node[align=center, text width=2.7cm] at (1.5,-11.1) {\itshape ellipsoid\\[3pt]\upshape\small $\displaystyle \frac{x^2}{4}+\frac{y^2}{9}+\frac{z^2}{16}=1$};
  \begin{axis}[icon, at={(4.45cm,-11.1cm)}, anchor=center, xmin=-2.6,xmax=2.6,ymin=-3.6,ymax=3.6,zmin=-4.6,zmax=4.6]
    \addplot3[surfacestyle, domain=0:360, samples=19, y domain=0:180, samples y=16] ({2*sin(y)*cos(x)},{3*sin(y)*sin(x)},{4*cos(y)});
