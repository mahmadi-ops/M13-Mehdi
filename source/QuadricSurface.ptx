          <coordinates bbox="[-6,-8,6,8]" destination="[12,6,202,196]">
            <axes arrows="1" decorations="no" xlabel="y" ylabel="z"/>
            <group at="trace-x">
              <parametric-curve function="fa" domain="(-1.3,1.3)"
                          stroke="#0072B2" thickness="3"/>
              <parametric-curve function="fb" domain="(-1.3,1.3)"
                          stroke="#0072B2" thickness="3"/>
            </group>
          </coordinates>
          <label anchor="(105,214)" alignment="c"><m>x=0:\ \ \tfrac{z^2}{16} - \tfrac{y^2}{9} = 1</m></label>
        </coordinates>
        <annotations>
          <annotation ref="figure" text="The trace in the plane x = 0: a hyperbola opening up and down">
            <annotation ref="trace-x" text="In the plane x equals 0, the trace z squared over 16 minus y squared over 9 equals 1 is a hyperbola opening up and down with vertices at z equals plus or minus 4"/>
          </annotation>
        </annotations>
      </diagram>
    </prefigure>
   </image>
   <image xml:id="image-hyperboloid-two-sheets-trace-y">
    <shortdescription>
      The trace in the plane y = 0: a hyperbola opening up and down.
    </shortdescription>
    <prefigure xmlns="https://prefigure.org" label="hyperboloid-two-sheets-trace-y">
      <diagram dimensions="(210,232)" margins="5">
        <definition>fa(t) = (2*sinh(t), 4*cosh(t))</definition>
        <definition>fb(t) = (2*sinh(t), -4*cosh(t))</definition>
        <coordinates bbox="[0,0,210,232]">
          <coordinates bbox="[-5,-8,5,8]" destination="[12,6,202,196]">
            <axes arrows="1" decorations="no" xlabel="x" ylabel="z"/>
            <group at="trace-y">
              <parametric-curve function="fa" domain="(-1.3,1.3)"
                          stroke="#009E73" thickness="3"/>
              <parametric-curve function="fb" domain="(-1.3,1.3)"
                          stroke="#009E73" thickness="3"/>
            </group>
          </coordinates>
          <label anchor="(105,214)" alignment="c"><m>y=0:\ \ \tfrac{z^2}{16} - \tfrac{x^2}{4} = 1</m></label>
        </coordinates>
        <annotations>
          <annotation ref="figure" text="The trace in the plane y = 0: a hyperbola opening up and down">
            <annotation ref="trace-y" text="In the plane y equals 0, the trace z squared over 16 minus x squared over 4 equals 1 is a hyperbola opening up and down with vertices at z equals plus or minus 4"/>
          </annotation>
        </annotations>
      </diagram>
    </prefigure>
   </image>
   <image xml:id="image-hyperboloid-two-sheets-trace-z">
    <shortdescription>
      The trace in the plane z = 5: an ellipse.  Planes with the absolute value of z less than 4 miss the surface entirely.
    </shortdescription>
    <prefigure xmlns="https://prefigure.org" label="hyperboloid-two-sheets-trace-z">
