    </shortdescription>
    <prefigure xmlns="https://prefigure.org" label="hyperboloid-two-sheets-trace-y">
      <diagram dimensions="(210,232)" margins="5">
        <definition>fa(t) = (2*sinh(t), 4*cosh(t))</definition>
