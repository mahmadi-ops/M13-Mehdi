          <annotation ref="figure" text="The trace in the plane z = 5: an ellipse.  Planes with the absolute value of z less than 4 miss the surface entirely">
            <annotation ref="trace-z" text="In the plane z equals 5, the trace x squared over 4 plus y squared over 9 equals 9 over 16 is an ellipse.  Horizontal planes with the absolute value of z less than 4 do not intersect the surface at all"/>
          </annotation>
        </annotations>
      </diagram>
    </prefigure>
