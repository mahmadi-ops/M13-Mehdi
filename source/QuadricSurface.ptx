                          stroke="#D55E00" thickness="3"/>
          </coordinates>
          <label anchor="(105,214)" alignment="c"><m>z=5:\ \ \tfrac{x^2}{4} + \tfrac{y^2}{9} = \tfrac{9}{16}</m></label>
        </coordinates>
