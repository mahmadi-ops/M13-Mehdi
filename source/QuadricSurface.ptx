  \node[align=center, text width=4.1cm] at (12.5,-11.1) {\normalsize $\frac{x^2}{4}+\frac{z^2}{16}=1-\frac{c^2}{9}$\\[3pt]\itshape ellipse\\[3pt]{\small\normalfont\color{black!55} point if $c=\pm3$}};
  \node[align=center, text width=4.1cm] at (16.9,-11.1) {\normalsize $\frac{x^2}{4}+\frac{y^2}{9}=1-\frac{c^2}{16}$\\[3pt]\itshape ellipse\\[3pt]{\small\normalfont\color{black!55} point if $c=\pm4$}};
  \node[align=center, text width=2.7cm] at (1.5,-15.1) {\itshape elliptic cone\\[3pt]\upshape\small $\displaystyle z^2=\frac{x^2}{4}+\frac{y^2}{9}$};
  \begin{axis}[icon, at={(4.45cm,-15.1cm)}, anchor=center, xmin=-3.5,xmax=3.5,ymin=-5,ymax=5,zmin=-1.8,zmax=1.8]
    \addplot3[surfacestyle, domain=0:360, samples=19, y domain=-1.6:1.6, samples y=14] ({2*y*cos(x)},{3*y*sin(x)},{y});
  \end{axis}
  \node[align=center, text width=4.1cm] at (8.1,-15.1) {\normalsize $z^2-\frac{y^2}{9}=\frac{c^2}{4}$\\[3pt]\itshape hyperbola\\[3pt]{\small\normalfont\color{black!55} opens up--down;\\ two lines if $c=0$}};
  \node[align=center, text width=4.1cm] at (12.5,-15.1) {\normalsize $z^2-\frac{x^2}{4}=\frac{c^2}{9}$\\[3pt]\itshape hyperbola\\[3pt]{\small\normalfont\color{black!55} opens up--down;\\ two lines if $c=0$}};
  \node[align=center, text width=4.1cm] at (16.9,-15.1) {\normalsize $\frac{x^2}{4}+\frac{y^2}{9}=c^2$\\[3pt]\itshape ellipse\\[3pt]{\small\normalfont\color{black!55} point $(0,0,0)$ if $c=0$}};
  \node[align=center, text width=2.7cm] at (1.5,-19.1) {\itshape hyperboloid\\ of one sheet\\[3pt]\upshape\small $\displaystyle \frac{x^2}{4}+\frac{y^2}{9}-\frac{z^2}{16}=1$};
  \begin{axis}[icon, at={(4.45cm,-19.1cm)}, anchor=center, xmin=-3,xmax=3,ymin=-4.4,ymax=4.4,zmin=-3.8,zmax=3.8]
    \addplot3[surfacestyle, domain=0:360, samples=19, y domain=-0.85:0.85, samples y=13] ({2*cosh(y)*cos(x)},{3*cosh(y)*sin(x)},{4*sinh(y)});
