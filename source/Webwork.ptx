<?xml version="1.0" encoding="utf-8"?>
<section xml:id="section-4" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Webwork</title>
  <p>
    In this section, we will include samples of Webwork problems.
  </p>

<webwork>
  <pg-code>
    Context("LimitedNumeric");
   $a=random(2,8,1);
$b=random(2,8,1);
$c=random(2,8,1);
$ysign=list_random(0,1);
$zsign=list_random(0,1);
$sum=$ysign+$zsign+1;
if ($ysign==0) {$ysign='-'};
if ($ysign==1) {$ysign='+'};
if ($zsign==0) {$zsign='-'};
if ($zsign==1) {$zsign='+'};
if($sum==1) {$ans='a hyperboloid of two sheets'};
if($sum==2) {$ans='a hyperboloid of one sheet'};
if($sum==3) {$ans='an ellipsoid'};
  </pg-code>

<statement>


<p>
State whether the equation 
</p>
<m> \left( \frac{x}{<var name="$a"/>} \right)^2 $ysign \left( \frac{y}{$b} \right)^2 $zsign \left( \frac{z}{$c} \right)^2=1\) </m>
<p>
defines (enter number of statement): 
</p>
<p>
1. A hyperboloid of two sheets
2. A hyperboloid of one sheet
3. An ellipsoid
4. None of these
</p>
</statement>

  <solution>
    <p>
      <m><var name="$a"/> + <var name="$b"/> = <var name="$c"/></m>.
    </p>
  </solution>
</webwork>
  
</section>