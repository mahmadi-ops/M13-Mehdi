<?xml version="1.0" encoding="utf-8"?>
<section xml:id="section-4" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Webwork</title>
  <p>
    In this section, we will include samples of Webwork problems.
  </p>

<webwork>
  <pg-code>
    Context("LimitedNumeric");
   $a=random(2,8,1);
$b=random(2,8,1);
$c=random(2,8,1);
$ysign=list_random(0,1);
$zsign=list_random(0,1);
$sum=$ysign+$zsign+1;
if ($ysign==0) {$ysign='-'};
if ($ysign==1) {$ysign='+'};
if ($zsign==0) {$zsign='-'};
if ($zsign==1) {$zsign='+'};
if($sum==1) {$ans='a hyperboloid of two sheets'};
if($sum==2) {$ans='a hyperboloid of one sheet'};
if($sum==3) {$ans='an ellipsoid'};
  </pg-code>

<statement>


<p>
State whether the equation 
</p>
<m> \left( \frac{x}{<var name="$a"/>} \right)^2 <var name="$ysign"/> \left( \frac{y}{<var name="$b"/>} \right)^2 <var name="$zsign"/> \left( \frac{z}{<var name="$c"/>} \right)^2=1 </m>
<p>
defines (enter number of statement): 
</p>
<p>
  <ol>
    <li> A hyperboloid of two sheets</li>
    <li> A hyperboloid of one sheet</li>
    <li> An ellipsoid</li>
    <li> None of these</li>
  </ol>
</p>
</statement>

  <solution>
    <p>
     This equation is the equation of <m></m>.
    </p>
  </solution>
</webwork>

<webwork>
  <pg-code>
    Context("LimitedNumeric");
    $a = Compute(random(1, 9));
    $b = Compute(random(1, 9));
    $c = $a + $b;
  </pg-code>

  <statement>
    <p>
      Compute <m><var name="$a"/> + <var name="$b"/></m>.
    </p>
    <instruction>
      Type your answer without using the <c>+</c> sign.
    </instruction>
    <p>
      The sum is <var name="$c" width="2"/>.
    </p>
  </statement>

  <solution>
    <p>
      <m><var name="$a"/> + <var name="$b"/> = <var name="$c"/></m>.
    </p>
  </solution>
</webwork>
  
</section>