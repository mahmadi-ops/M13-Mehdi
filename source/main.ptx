<?xml version="1.0" encoding="utf-8"?>
<pretext xml:lang="en-US" xmlns:xi="http://www.w3.org/2001/XInclude">

 <docinfo>
  
  <document-id edition="1">math13</document-id>
  <blurb shelf="Mathematics">Interactive, accessible web-based modules for multivariable calculus (Santa Clara University's MATH 13). The materials strengthen conceptual understanding of foundational ideas (parametrization, Taylor approximation, dot and cross products, conic sections, quadric surfaces, directional derivatives and the gradient, and extreme values) through explicit connections to physical phenomena, with support for diverse learners including screen-reader and tactile-graphics users.</blurb>
  <macros>
    \newcommand{\deriv}[2]{\displaystyle \frac{d#1}{d#2}}
    \newcommand{\real}{\Bbb R}
    \newcommand{\R}{\mathbb{R}}
  </macros>

<latex-image-preamble>
  \usepackage{tikz}
  \usepackage{amsmath}
  \usetikzlibrary{decorations.pathmorphing, arrows.meta, calc}
  \usepackage{tikz-3dplot}
  \usepackage{pgfplots}
\pgfplotsset{compat=1.17}
  <!-- Palette used by the figures in ch-12-5.ptx, matching the colors of
       the animations they were drawn from.  msky is the light fill for
       planes; the others are used for lines, vectors and points. -->
  \definecolor{mblue}{HTML}{2B6CB0}
  \definecolor{msky}{HTML}{58C4DD}
  \definecolor{mred}{HTML}{E04B4B}
  \definecolor{mpink}{HTML}{D147BD}
  \definecolor{mgreen}{HTML}{4FA84F}
  \definecolor{morange}{HTML}{E08A2B}
  \definecolor{mverm}{HTML}{D55E00}
  \definecolor{mgray}{HTML}{7F7F7F}
</latex-image-preamble>
