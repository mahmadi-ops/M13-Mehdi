  <annotation ref="ga-altitude" text="The altitude from C down to the point D on the hypotenuse, drawn in blue, of length h equal to the square root of a b."/>
  <annotation ref="ga-right-d" text="The right angle marker at D, showing that the altitude meets the hypotenuse perpendicularly."/>
  <annotation ref="ga-tri-left" text="The left small triangle A D C, shaded light blue, with legs a and h. It is similar to the whole triangle."/>
  <annotation ref="ga-tri-right" text="The right small triangle D B C, shaded light orange, with legs b and h. It too is similar to the whole triangle, so the ratio a to h equals the ratio h to b."/>
  <annotation ref="ga-label-a" text="The label a for the left piece of the hypotenuse, from A to D, of length 4."/>
  <annotation ref="ga-label-b" text="The label b for the right piece of the hypotenuse, from D to B, of length 1."/>
</annotation>
</annotations>
</diagram>
