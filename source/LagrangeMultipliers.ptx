      stroke="#009E73" thickness="2.5"/>
<line at="pd-far1" endpoints="((0.8,-0.4),(-0.3,2.1))"
      stroke="#7F7F7F" dash="5 4" thickness="1.5"/>
<line at="pd-far2" endpoints="((0.8,-0.4),(2.9,0.5))"
      stroke="#7F7F7F" dash="5 4" thickness="1.5"/>
<line at="pd-ra1" endpoints="((1.714,1.093),(1.647,0.959))"
      stroke="black" thickness="1.5"/>
<line at="pd-ra2" endpoints="((1.647,0.959),(1.513,1.026))"
      stroke="black" thickness="1.5"/>
<vector at="pd-seg" v="(0.78,1.56)" tail="(0.8,-0.4)"
        stroke="#D55E00" thickness="3"/>
<vector at="pd-n" v="(0.335,0.671)" tail="(3.1,0.4)"
        stroke="#0072B2" thickness="3"/>
