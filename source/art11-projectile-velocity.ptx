<?xml version="1.0" encoding="UTF-8"?>

<!--
  Velocity and direction of a projectile after a given time.
  Worksheet for the Exercises chapter (Projectile Motion / Parametrization).
  The figure is a PreFigure <diagram> embedded directly inside <image>.
-->

<worksheet xml:id="exercises-projectile-velocity">
  <title> Exercises for <xref ref="section-parametrization" text="title"/></title>

  <introduction>
    <p>
      If you would like to review this topic before attempting the exercises,
      click <xref ref="section-parametrization" text="title"/>.
    </p>
    <p>
      The exercises below on the velocity and direction of a projectile after a
      given time use the figure of a projectile at a general instant.
    </p>

    <figure xml:id="fig-velocity-at-P">
      <caption>
        A particle projected from <m>O</m> with speed <m>v_0</m> at elevation
        <m>\theta</m>. At the point <m>P</m> reached after time <m>t</m>, the
        velocity <m>v</m> is tangent to the path and makes an angle <m>\phi</m>
        with the horizontal; <m>h</m> is the depth of <m>P</m> below the directrix.
      </caption>
      <image width="85%" xml:id="image-velocity-at-P">
        <!-- PreFigure source embedded inline -->
        <prefigure xmlns="https://prefigure.org" label="prefigure-velocity-at-P">
        <diagram dimensions="(420,300)" margins="5">
          <definition>f(x) = 0.2*x*(8 - x)</definition>
          <coordinates bbox="(-1.2, -1, 9.6, 5.4)">
            <axes at="vp-axes" xlabel="x" ylabel="y" decorations="no"/>
            <!-- directrix (for the corollary) -->
            <line at="vp-directrix" p1="(-0.5,4.45)" p2="(8.8,4.45)" stroke="gray" dash="4"/>
            <label anchor="(3.3,4.45)" alignment="n"><m>\text{directrix}</m></label>
            <!-- parabolic trajectory -->
            <graph at="vp-path" domain="(0,8)" function="f" stroke="blue" thickness="2"/>
            <!-- vertical fall from the directrix down to P -->
            <line at="vp-h" p1="(6,2.4)" p2="(6,4.45)" stroke="gray" dash="4"/>
            <label anchor="(6,3.42)" alignment="w"><m>h</m></label>
            <!-- initial velocity at O -->
            <line at="vp-v0" p1="(0,0)" p2="(1.06,1.70)" stroke="red" thickness="2" arrows="1"/>
            <angle-marker at="vp-theta" points="((1,0),(0,0),(1.06,1.70))" radius="30" stroke="black"><m>\theta</m></angle-marker>
            <label anchor="(1.06,1.70)" alignment="nw"><m>v_0</m></label>
            <!-- velocity components triangle at P -->
            <line at="vp-vcos" p1="(6,2.4)" p2="(7.64,2.4)" stroke="gray" dash="3"/>
            <line at="vp-vsin" p1="(7.64,2.4)" p2="(7.64,1.09)" stroke="gray" dash="3"/>
            <label anchor="(6.82,2.4)" alignment="n"><m>v\cos\phi</m></label>
            <label anchor="(7.64,1.745)" alignment="e"><m>v\sin\phi</m></label>
            <!-- velocity vector at P (tangent to path) -->
            <line at="vp-v" p1="(6,2.4)" p2="(7.64,1.09)" stroke="red" thickness="2" arrows="1"/>
            <angle-marker at="vp-phi" points="((7.64,1.09),(6,2.4),(7.64,2.4))" radius="26" stroke="black"><m>\phi</m></angle-marker>
            <label anchor="(6.82,1.745)" alignment="sw" offset="(-2,-2)"><m>v</m></label>
            <!-- key points -->
            <point at="vp-O" p="(0,0)" size="3"/>
            <point at="vp-P" p="(6,2.4)" size="3"/>
            <label anchor="(0,0)" alignment="sw"><m>O</m></label>
            <label anchor="(6,2.4)" alignment="nw" offset="(-4,6)"><m>P</m></label>
          </coordinates>

          <annotations>
          <annotation ref="figure" text="A particle is launched from O and follows a parabolic path. At the point P reached after time t, the velocity v is tangent to the path and makes an angle phi with the horizontal. A horizontal directrix lies above the path, and h is the depth of P below it.">
            <annotation ref="vp-axes" text="Horizontal and vertical axes with origin at the launch point O."/>
            <annotation ref="vp-path" text="The parabolic trajectory of the particle, drawn in blue."/>
            <annotation ref="vp-directrix" text="The directrix, a horizontal dashed line above the trajectory."/>
            <annotation ref="vp-h" text="The vertical depth h of the point P below the directrix."/>
            <annotation ref="vp-v0" text="The initial velocity v naught at O, directed at elevation angle theta above the horizontal."/>
            <annotation ref="vp-theta" text="The angle theta between the horizontal and the initial velocity at O."/>
            <annotation ref="vp-v" text="The velocity v at P, tangent to the path, pointing down and to the right."/>
            <annotation ref="vp-phi" text="The angle phi between the horizontal and the velocity at P."/>
            <annotation ref="vp-vcos" text="The horizontal component v cosine phi of the velocity at P."/>
            <annotation ref="vp-vsin" text="The vertical component v sine phi of the velocity at P."/>
            <annotation ref="vp-O" text="The launch point O at the origin."/>
            <annotation ref="vp-P" text="The point P on the path reached after time t."/>
          </annotation>
          </annotations>
        </diagram>
        </prefigure>
      </image>
    </figure>
  </introduction>

  <exercise xml:id="exercise-velocity-direction">
    <statement>
      <p>
        A particle is projected from <m>O</m> with speed <m>v_0</m> at an
        elevation <m>\theta</m> to the horizontal, as in
        <xref ref="fig-velocity-at-P"/>. At time <m>t</m> it is at the point
        <m>P</m>, moving with speed <m>v</m> in a direction making an angle
        <m>\phi</m> with the horizontal. Show that
        <md>
          v = \sqrt{\,v_0^2 - 2\,v_0\,g\,t\sin\theta + g^2 t^2\,}
        </md>
        and
        <md>
          \tan\phi = \frac{v_0\sin\theta - g\,t}{v_0\cos\theta}\text{.}
        </md>
      </p>
    </statement>
    <solution>
      <p>
        Take the origin at <m>O</m> with horizontal and vertical axes. The
        coordinates of <m>P</m> at time <m>t</m> are
        <md>
          x = v_0\cos\theta\;t\text{,} \qquad
          y = v_0\sin\theta\;t - \tfrac{1}{2}g\,t^2\text{.}
        </md>
        The horizontal and vertical components of the velocity are the time
        derivatives of these, so
        <md>
          v\cos\phi = \frac{dx}{dt} = v_0\cos\theta\text{,} \qquad
          v\sin\phi = \frac{dy}{dt} = v_0\sin\theta - g\,t\text{.}
        </md>
        Squaring and adding eliminates <m>\phi</m>:
        <md>
          v^2 = v_0^2\cos^2\theta + \bigl(v_0\sin\theta - g\,t\bigr)^2
              = v_0^2 - 2\,v_0\,g\,t\sin\theta + g^2 t^2\text{,}
        </md>
        which gives the speed at time <m>t</m>. Dividing the vertical component
        by the horizontal component gives the direction,
        <md>
          \tan\phi = \frac{v_0\sin\theta - g\,t}{v_0\cos\theta}\text{,}
        </md>
        that is, <m>\phi = \arctan\!\left(\dfrac{v_0\sin\theta - g\,t}{v_0\cos\theta}\right)</m>.
      </p>
    </solution>
  </exercise>

  <exercise xml:id="exercise-directrix-freefall">
    <statement>
      <p>
        The <term>directrix</term> of the parabolic path is the horizontal line
        at height <m>\dfrac{v_0^2}{2g}</m> above <m>O</m>. Using the previous
        exercise, show that the speed of the particle at <m>P</m> is equal to the
        speed it would acquire by falling freely from the level of the directrix
        down to <m>P</m>. That is, if <m>h</m> denotes the depth of <m>P</m>
        below the directrix (see <xref ref="fig-velocity-at-P"/>), then
        <m>v^2 = 2\,g\,h</m>.
      </p>
    </statement>
    <solution>
      <p>
        From the previous exercise,
        <md>
          v^2 = v_0^2 - 2\,v_0\,g\,t\sin\theta + g^2 t^2
              = v_0^2 - 2g\!\left(v_0\,t\sin\theta - \tfrac{1}{2}g\,t^2\right)
              = v_0^2 - 2 g y\text{,}
        </md>
        since <m>y = v_0\,t\sin\theta - \tfrac{1}{2}g\,t^2</m> is the height of
        <m>P</m>. Writing this as
        <md>
          v^2 = 2g\!\left(\frac{v_0^2}{2g} - y\right)
        </md>
        and recognizing <m>\dfrac{v_0^2}{2g}</m> as the height of the directrix
        above <m>O</m>, the quantity <m>h = \dfrac{v_0^2}{2g} - y</m> is exactly
        the depth of <m>P</m> below the directrix. Hence <m>v^2 = 2\,g\,h</m>,
        the square of the speed gained by falling freely through the height
        <m>h</m>.
      </p>
    </solution>
  </exercise>
<exercise xml:id="rf-2">
<statement>
<p>
Find the Cartesian equation <m>f(x,y) = 0</m> for the curve
represented by the following parametric equations, then graph it:
<md>
<mrow>x(t) \amp = e^{2t},</mrow>
<mrow>y(t) \amp = e^{t} - 1,</mrow>
<mrow>0 \amp \le t \le \ln(2).</mrow>
</md>
</p>
</statement>
<solution>
<p>
From the second equation, <m>y + 1 = e^t</m>, and hence
<md>
x = e^{2t} = \left(e^{t}\right)^2 = (y+1)^2
\;\Rightarrow\;
y + 1 = \sqrt{x}
\;\Rightarrow\;
y = \sqrt{x} - 1.
</md>
For the range, note that <m>0 \le t \le \ln(2)</m> gives
<md>
e^0 \le e^t \le e^{\ln(2)}
\;\Rightarrow\; 1 \le e^t \le 2
\;\Rightarrow\; 0 \le e^t - 1 \le 1
\;\Rightarrow\; 0 \le y \le 1,
</md>
and correspondingly <m>1 \le x \le 4</m>. The curve is the portion of
<m>y = \sqrt{x} - 1</m> from <m>(1,0)</m> to <m>(4,1)</m>, shown in
<xref ref="fig-rf-parametric"/>.
</p>

<figure xml:id="fig-rf-parametric">
<caption>
The curve <m>y = \sqrt{x} - 1</m> traced by the parametric equations
for <m>0 \le t \le \ln(2)</m>, from <m>(1,0)</m> to <m>(4,1)</m>.
</caption>
<image width="66%">
<prefigure xmlns="https://prefigure.org" label="prefigure-rf-parametric">
<diagram dimensions="(360,220)" margins="12">
<definition>c(t) = (t, t^(1/2) - 1)</definition>
<coordinates bbox="(-0.6,-0.7,4.9,1.7)">
<grid-axes xlabel="x" ylabel="y"/>
<parametric-curve at="rf2-curve" function="c" domain="(1,4)"
                  stroke="#8B1A4A" thickness="3"/>
<point at="rf2-start" p="(1,0)" fill="#8B1A4A"/>
<point at="rf2-end" p="(4,1)" fill="#8B1A4A"/>
<label at="rf2-lab" anchor="(2.15,0.85)" alignment="nw" color="#8B1A4A">
<m>y=\sqrt{x}-1</m>
</label>
<label at="rf2-start-lab" anchor="(1.05,-0.18)" alignment="se">
<m>(1,0)</m>
</label>
<label at="rf2-end-lab" anchor="(4.05,0.95)" alignment="se">
<m>(4,1)</m>
</label>
</coordinates>

<annotations>
<annotation ref="figure" text="A short dark red curve rises from the point one comma zero to the point four comma one, following the graph of y equals the square root of x minus one. Both endpoints are marked with dots.">
  <annotation ref="rf2-curve" text="The curve y equals square root of x minus one, for x between one and four."/>
  <annotation ref="rf2-start" text="The starting point one comma zero, corresponding to t equals zero."/>
  <annotation ref="rf2-end" text="The ending point four comma one, corresponding to t equals natural log of two."/>
</annotation>
</annotations>
</diagram>
</prefigure>
</image>
</figure>
</solution>
</exercise>

<exercise xml:id="rw23-8">
<statement>
<p>
Provide a parametrized form of the curve given by
<md>
x^2 + 4y^2 + 8y - 2\sqrt{21}\,x = 0.
</md>
Assume that the curve is traced <term>counter-clockwise</term> as the
parameter increases.
</p>
</statement>
<solution>
<p>
We complete the squares:
<md>
<mrow>\left(x - \sqrt{21}\right)^2 - 21
+ 4(y+1)^2 - 4 \amp = 0</mrow>
<mrow>\left(x - \sqrt{21}\right)^2 + 4(y+1)^2 \amp = 25.</mrow>
</md>
This is an ellipse centered at <m>\left(\sqrt{21}, -1\right)</m>.
Setting
<md>
x - \sqrt{21} = 5\cos t
\quad\text{and}\quad
2(y+1) = 5\sin t
</md>
gives the counter-clockwise parametrization
<md>
<mrow>x(t) \amp = 5\cos t + \sqrt{21}</mrow>
<mrow>y(t) \amp = \frac52 \sin t - 1</mrow>
<mrow>0 \amp \le t \le 2\pi.</mrow>
</md>
See <xref ref="fig-rw23-ellipse"/>.
</p>

<figure xml:id="fig-rw23-ellipse">
<caption>
The ellipse <m>\left(x - \sqrt{21}\right)^2 + 4(y+1)^2 = 25</m>,
centered at <m>\left(\sqrt{21}, -1\right)</m> with semi-axes <m>5</m>
and <m>\frac52</m>, traced counter-clockwise.
</caption>
<image width="70%">
<prefigure xmlns="https://prefigure.org" label="prefigure-rw23-ellipse">
<diagram dimensions="(380,240)" margins="12">
<definition>ell(t) = (5*cos(t) + 4.5826, 2.5*sin(t) - 1)</definition>
<coordinates bbox="(-1.3,-4.4,10.6,2.6)">
<grid-axes xlabel="x" ylabel="y"/>
<parametric-curve at="el-curve" function="ell" domain="(0,6.2832)"
                  stroke="#0072B2" thickness="3"/>
<vector at="el-dir" v="(-0.45,0.70)" tail="(9.35,-0.25)"
        stroke="#D55E00" thickness="3"/>
<point at="el-center" p="(4.5826,-1)" fill="#8B1A4A"/>
<label at="el-center-lab" anchor="(4.62,-1.35)" alignment="se" color="#8B1A4A">
<m>\left(\sqrt{21},-1\right)</m>
</label>
<label at="el-dir-lab" anchor="(9.05,0.65)" alignment="ne" color="#D55E00">
<m>t</m>
</label>
</coordinates>

<annotations>
<annotation ref="figure" text="A wide blue ellipse centered at the point square root of twenty one comma negative one, with horizontal semi axis five and vertical semi axis five halves. A short vermillion arrow on the right side of the ellipse points up and to the left, showing the counter clockwise direction of increasing parameter t.">
  <annotation ref="el-curve" text="The ellipse traced by the parametrization, counter clockwise."/>
  <annotation ref="el-center" text="The center of the ellipse at square root of twenty one comma negative one."/>
  <annotation ref="el-dir" text="The direction of increasing t, counter clockwise."/>
</annotation>
</annotations>
</diagram>
</prefigure>
</image>
</figure>
</solution>
</exercise>

<exercise xml:id="rw17-2">
<statement>
<p>
An airplane moves in a trajectory given by the parametric equations
<md>
x = 4t, \qquad y = t, \qquad z = t^2.
</md>
Given this trajectory, the airplane will intersect the surface
<m>z = x - y^2 + 16</m> twice. Determine the tangent plane to the
surface at the location where the airplane <em>first</em> crosses the
surface.
</p>
</statement>
<solution>
<p>
We first find the crossing times by substituting the trajectory into
the equation of the surface:
<md>
<mrow>t^2 \amp = 4t - t^2 + 16
\;\Rightarrow\; 2t^2 - 4t - 16 = 0</mrow>
<mrow>\amp \;\Rightarrow\; t^2 - 2t - 8 = 0
\;\Rightarrow\; (t-4)(t+2) = 0,</mrow>
</md>
so <m>t = -2</m> or <m>t = 4</m>. The first crossing occurs at the
earlier time <m>t = -2</m>, at the point
<md>
x = 4(-2) = -8, \qquad y = -2, \qquad z = (-2)^2 = 4,
</md>
i.e. at <m>P_0(-8, -2, 4)</m>.
</p>

<p>
Writing the surface as a level surface
<m>F(x,y,z) = x - y^2 + 16 - z = 0</m>, the normal vector is
<md>
\vec n = \nabla F = \langle 1, -2y, -1\rangle,
\qquad
\vec n\big|_{P_0} = \langle 1, 4, -1\rangle.
</md>
Hence the tangent plane at <m>P_0</m> is
<md>
<mrow>1(x+8) + 4(y+2) - 1(z-4) \amp = 0</mrow>
<mrow>\amp \;\Rightarrow\; x + 4y - z + 20 = 0,</mrow>
<mrow>\amp \;\Rightarrow\; z = x + 4y + 20.</mrow>
</md>
As a check, at <m>(-8,-2)</m> this gives
<m>z = -8 - 8 + 20 = 4</m>, which is the correct height.
</p>
</solution>
</exercise>

<exercise xml:id="pp-15">
<statement>
<p>
<ol marker="A.">
<li>
<p>
Parametrize the intersection of <m>x^2 + y^2 + z^2 = 25</m> and the
plane <m>x = 4</m>.
</p>
</li>
<li>
<p>
Which axis is perpendicular to the plane <m>x = 4</m>?
</p>
</li>
</ol>
</p>
</statement>
<solution>
<p>
<ol marker="A.">
<li>
<p>
Substituting <m>x = 4</m> into the equation of the sphere,
<md>
16 + y^2 + z^2 = 25 \;\Rightarrow\; y^2 + z^2 = 9,
</md>
a circle of radius <m>3</m> lying in the plane <m>x = 4</m>. Hence
<md>
x = 4, \qquad y = 3\cos(t), \qquad z = 3\sin(t),
\qquad 0 \le t \le 2\pi.
</md>
</p>
</li>
<li>
<p>
The plane <m>x = 4</m> has normal vector
<m>\langle 1, 0, 0\rangle</m>, so the <m>x</m>-axis is perpendicular
to it.
</p>
</li>
</ol>
</p>
</solution>
</exercise>

<exercise xml:id="pp-16">
<statement>
<p>
Consider the parametrization <m>x = 2 - t - t^3</m> and
<m>y = 3t^2 - 6t + 1</m>. Find <m>\dfrac{dy}{dx}</m> at the point with
<m>(x,y)</m>-coordinates <m>(0,-2)</m>.
</p>
</statement>
<solution>
<p>
First find the parameter value. From <m>y = -2</m>,
<md>
3t^2 - 6t + 1 = -2 \;\Rightarrow\; 3t^2 - 6t + 3 = 0
\;\Rightarrow\; t^2 - 2t + 1 = 0 \;\Rightarrow\; t = 1,
</md>
and this checks out in the first equation:
<m>x = 2 - 1 - 1 = 0</m>.
</p>

<p>
For a parametrized curve,
<m>\dfrac{dy}{dx} = \dfrac{dy/dt}{dx/dt}</m>, and
<md>
\frac{dy}{dt} = 6t - 6,
\qquad
\frac{dx}{dt} = -1 - 3t^2.
</md>
At <m>t = 1</m>,
<md>
\frac{dy}{dx} = \frac{6(1) - 6}{-1 - 3(1)} = \frac{0}{-4} = 0.
</md>
The tangent line there is horizontal.
</p>
</solution>
</exercise>

<exercise xml:id="pp-19">
<statement>
<p>
Parametrize the intersection of the surfaces
<m>4x^2 + z^2 = 16</m> and <m>y = z</m>.
</p>
</statement>
<solution>
<p>
The first surface does not involve <m>y</m>; dividing by <m>16</m>,
<md>
\frac{x^2}{4} + \frac{z^2}{16} = 1,
</md>
which is an ellipse in the <m>xz</m>-plane with semi-axes <m>2</m>
(in <m>x</m>) and <m>4</m> (in <m>z</m>). It is parametrized by
<m>x = 2\cos(t)</m>, <m>z = 4\sin(t)</m>. The second surface simply
forces <m>y = z</m>, so
<md>
x = 2\cos(t), \qquad y = 4\sin(t), \qquad z = 4\sin(t),
\qquad 0 \le t \le 2\pi.
</md>
</p>
</solution>
</exercise>

<exercise xml:id="m2a-2">
<statement>
<p>
Consider the curve <m>25(y+4)^2 + 400(x-1)^2 = 100</m>.
<ol marker="(a)">
<li>
<p>
Sketch the curve and label its important points.
</p>
</li>
<li>
<p>
Parametrize the entire curve using one parametrization.
</p>
</li>
</ol>
</p>
</statement>
<solution>
<p>
<term>(a)</term> Divide both sides by <m>100</m> to put the equation in
standard form:
<md>
<mrow>\frac{25(y+4)^2}{100} + \frac{400(x-1)^2}{100} \amp = 1</mrow>
<mrow>\frac{(y+4)^2}{4} + 4(x-1)^2 \amp = 1</mrow>
<mrow>\frac{(x-1)^2}{\left(\frac12\right)^2} + \frac{(y+4)^2}{2^2}
  \amp = 1 .</mrow>
</md>
</p>

<p>
This is an ellipse with centre <m>(1,-4)</m>, semi-axis
<m>a = \tfrac12</m> in the <m>x</m>-direction and semi-axis
<m>b = 2</m> in the <m>y</m>-direction. Since <m>b \gt a</m>, the major
axis is vertical. The four vertices are
<md>
\left(\tfrac12, -4\right), \quad \left(\tfrac32, -4\right), \quad
(1,-2), \quad (1,-6),
</md>
and the foci lie on the vertical axis at distance
<m>c = \sqrt{b^2-a^2} = \sqrt{4-\tfrac14} = \tfrac{\sqrt{15}}{2}
\approx 1.94</m>
from the centre. See <xref ref="fig-m2a-ellipse"/>.
</p>

<figure xml:id="fig-m2a-ellipse">
<caption>
The ellipse <m>25(y+4)^2 + 400(x-1)^2 = 100</m>, with centre
<m>(1,-4)</m>, horizontal semi-axis <m>\tfrac12</m> and vertical
semi-axis <m>2</m>.
</caption>
<image width="62%">
<description>
<p>
A tall narrow ellipse centred at the point one comma negative four. Its
topmost and bottommost points are one comma negative two and one comma
negative six, and its leftmost and rightmost points are one half comma
negative four and three halves comma negative four.
</p>
</description>
<prefigure xmlns="https://prefigure.org" label="prefigure-m2a-ellipse">
<diagram dimensions="(330,470)" margins="30">
<definition>ell(t) = (1 + 0.5*cos(t), -4 + 2*sin(t))</definition>
<coordinates bbox="(-0.85,-7.4,2.8,-0.6)">
<grid-axes at="m2ae-axes" xlabel="x" ylabel="y"/>
<parametric-curve at="m2ae-e" function="ell" domain="(0,6.2832)"
                  stroke="#0072B2" thickness="2.5"/>
<point at="m2ae-c" p="(1,-4)" fill="#8B1A4A"/>
<point at="m2ae-t" p="(1,-2)" fill="#D55E00"/>
<point at="m2ae-b" p="(1,-6)" fill="#D55E00"/>
<point at="m2ae-l" p="(0.5,-4)" fill="#009E73"/>
<point at="m2ae-r" p="(1.5,-4)" fill="#009E73"/>
<label at="m2ae-clab" anchor="(0.42,-3.72)" alignment="w" color="#8B1A4A">
<m>(1,-4)</m>
</label>
<label at="m2ae-tlab" anchor="(1.1,-1.95)" alignment="ne" color="#D55E00">
<m>(1,-2)</m>
</label>
<label at="m2ae-blab" anchor="(1.1,-6.05)" alignment="se" color="#D55E00">
<m>(1,-6)</m>
</label>
<label at="m2ae-llab" anchor="(0.44,-4.28)" alignment="sw" color="#009E73">
<m>\left(\tfrac12,-4\right)</m>
</label>
<label at="m2ae-rlab" anchor="(1.56,-4.0)" alignment="e" color="#009E73">
<m>\left(\tfrac32,-4\right)</m>
</label>
</coordinates>

<annotations>
<annotation ref="figure" text="A tall narrow blue ellipse in the fourth quadrant region below the x axis, centred at one comma negative four. Five points are marked and labelled: the centre, the top vertex at one comma negative two, the bottom vertex at one comma negative six, and the left and right vertices at one half and three halves, each with y equal to negative four.">
  <annotation ref="m2ae-e" text="The ellipse twenty five times the square of y plus four, plus four hundred times the square of x minus one, equals one hundred."/>
  <annotation ref="m2ae-c" text="The centre of the ellipse, at one comma negative four."/>
</annotation>
</annotations>
</diagram>
</prefigure>
</image>
</figure>

<p>
<term>(b)</term> For a circle <m>x^2+y^2=r^2</m> we would use
<m>x = r\cos t</m>, <m>y = r\sin t</m>. Here the standard form tells us
that
<md>
\frac{x-1}{\frac12} \quad\text{and}\quad \frac{y+4}{2}
</md>
play the roles of <m>\cos t</m> and <m>\sin t</m>, since their squares
add to <m>1</m>. So we set
<md>
\frac{x-1}{\frac12} = \cos t, \qquad \frac{y+4}{2} = \sin t ,
</md>
which gives
<md>
x = 1 + \frac12\cos t, \qquad y = -4 + 2\sin t,
\qquad 0 \le t \le 2\pi .
</md>
Letting <m>t</m> run over a full period of length <m>2\pi</m> traces
the entire ellipse exactly once, counterclockwise, starting at the
right vertex <m>\left(\tfrac32,-4\right)</m>.
</p>
</solution>
</exercise>

</worksheet>
