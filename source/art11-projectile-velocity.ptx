<?xml version="1.0" encoding="UTF-8"?>

<!--
  Velocity and direction of a projectile after a given time.
  Section-level <exercises> for the Projectile Motion section (1.3).
  The figure is a PreFigure <diagram> embedded directly inside <image>.
-->

<exercises xml:id="exercises-projectile-velocity">
  <title>Velocity and direction after a given time</title>

  <introduction>
    <p>
      The exercises below use the figure of a projectile at a general instant.
    </p>

    <figure xml:id="fig-velocity-at-P">
      <caption>
        A particle projected from <m>O</m> with speed <m>v_0</m> at elevation
        <m>\theta</m>. At the point <m>P</m> reached after time <m>t</m>, the
        velocity <m>v</m> is tangent to the path and makes an angle <m>\phi</m>
        with the horizontal; <m>h</m> is the depth of <m>P</m> below the directrix.
      </caption>
      <image width="85%" xml:id="image-velocity-at-P">
        <!-- PreFigure source embedded inline -->
        <prefigure xmlns="https://prefigure.org" label="prefigure-velocity-at-P">
        <diagram dimensions="(420,300)" margins="5">
          <definition>f(x) = 0.2*x*(8 - x)</definition>
          <coordinates bbox="(-1.2, -1, 9.6, 5.4)">
            <axes at="vp-axes" xlabel="x" ylabel="y" decorations="no"/>
            <!-- directrix (for the corollary) -->
            <line at="vp-directrix" p1="(-0.5,4.45)" p2="(8.8,4.45)" stroke="gray" dash="4"/>
            <label anchor="(3.3,4.45)" alignment="n"><m>\text{directrix}</m></label>
            <!-- parabolic trajectory -->
            <graph at="vp-path" domain="(0,8)" function="f" stroke="blue" thickness="2"/>
            <!-- vertical fall from the directrix down to P -->
            <line at="vp-h" p1="(6,2.4)" p2="(6,4.45)" stroke="gray" dash="4"/>
            <label anchor="(6,3.42)" alignment="w"><m>h</m></label>
            <!-- initial velocity at O -->
            <line at="vp-v0" p1="(0,0)" p2="(1.06,1.70)" stroke="red" thickness="2" arrows="1"/>
            <angle-marker at="vp-theta" points="((1,0),(0,0),(1.06,1.70))" radius="30" stroke="black"><m>\theta</m></angle-marker>
            <label anchor="(1.06,1.70)" alignment="nw"><m>v_0</m></label>
            <!-- velocity components triangle at P -->
            <line at="vp-vcos" p1="(6,2.4)" p2="(7.64,2.4)" stroke="gray" dash="3"/>
            <line at="vp-vsin" p1="(7.64,2.4)" p2="(7.64,1.09)" stroke="gray" dash="3"/>
            <label anchor="(6.82,2.4)" alignment="n"><m>v\cos\phi</m></label>
            <label anchor="(7.64,1.745)" alignment="e"><m>v\sin\phi</m></label>
            <!-- velocity vector at P (tangent to path) -->
            <line at="vp-v" p1="(6,2.4)" p2="(7.64,1.09)" stroke="red" thickness="2" arrows="1"/>
            <angle-marker at="vp-phi" points="((7.64,1.09),(6,2.4),(7.64,2.4))" radius="26" stroke="black"><m>\phi</m></angle-marker>
            <label anchor="(6.82,1.745)" alignment="sw" offset="(-2,-2)"><m>v</m></label>
            <!-- key points -->
            <point at="vp-O" p="(0,0)" size="3"/>
            <point at="vp-P" p="(6,2.4)" size="3"/>
            <label anchor="(0,0)" alignment="sw"><m>O</m></label>
            <label anchor="(6,2.4)" alignment="nw" offset="(-4,6)"><m>P</m></label>
          </coordinates>

          <annotations>
          <annotation ref="figure" text="A particle is launched from O and follows a parabolic path. At the point P reached after time t, the velocity v is tangent to the path and makes an angle phi with the horizontal. A horizontal directrix lies above the path, and h is the depth of P below it.">
            <annotation ref="vp-axes" text="Horizontal and vertical axes with origin at the launch point O."/>
            <annotation ref="vp-path" text="The parabolic trajectory of the particle, drawn in blue."/>
            <annotation ref="vp-directrix" text="The directrix, a horizontal dashed line above the trajectory."/>
            <annotation ref="vp-h" text="The vertical depth h of the point P below the directrix."/>
            <annotation ref="vp-v0" text="The initial velocity v naught at O, directed at elevation angle theta above the horizontal."/>
            <annotation ref="vp-theta" text="The angle theta between the horizontal and the initial velocity at O."/>
            <annotation ref="vp-v" text="The velocity v at P, tangent to the path, pointing down and to the right."/>
            <annotation ref="vp-phi" text="The angle phi between the horizontal and the velocity at P."/>
            <annotation ref="vp-vcos" text="The horizontal component v cosine phi of the velocity at P."/>
            <annotation ref="vp-vsin" text="The vertical component v sine phi of the velocity at P."/>
            <annotation ref="vp-O" text="The launch point O at the origin."/>
            <annotation ref="vp-P" text="The point P on the path reached after time t."/>
          </annotation>
          </annotations>
        </diagram>
        </prefigure>
      </image>
    </figure>
  </introduction>

  <exercise xml:id="exercise-velocity-direction">
    <statement>
      <p>
        A particle is projected from <m>O</m> with speed <m>v_0</m> at an
        elevation <m>\theta</m> to the horizontal, as in
        <xref ref="fig-velocity-at-P"/>. At time <m>t</m> it is at the point
        <m>P</m>, moving with speed <m>v</m> in a direction making an angle
        <m>\phi</m> with the horizontal. Show that
        <md>
          v = \sqrt{\,v_0^2 - 2\,v_0\,g\,t\sin\theta + g^2 t^2\,}
        </md>
        and
        <md>
          \tan\phi = \frac{v_0\sin\theta - g\,t}{v_0\cos\theta}\text{.}
        </md>
      </p>
    </statement>
    <solution>
      <p>
        Take the origin at <m>O</m> with horizontal and vertical axes. The
        coordinates of <m>P</m> at time <m>t</m> are
        <md>
          x = v_0\cos\theta\;t\text{,} \qquad
          y = v_0\sin\theta\;t - \tfrac{1}{2}g\,t^2\text{.}
        </md>
        The horizontal and vertical components of the velocity are the time
        derivatives of these, so
        <md>
          v\cos\phi = \frac{dx}{dt} = v_0\cos\theta\text{,} \qquad
          v\sin\phi = \frac{dy}{dt} = v_0\sin\theta - g\,t\text{.}
        </md>
        Squaring and adding eliminates <m>\phi</m>:
        <md>
          v^2 = v_0^2\cos^2\theta + \bigl(v_0\sin\theta - g\,t\bigr)^2
              = v_0^2 - 2\,v_0\,g\,t\sin\theta + g^2 t^2\text{,}
        </md>
        which gives the speed at time <m>t</m>. Dividing the vertical component
        by the horizontal component gives the direction,
        <md>
          \tan\phi = \frac{v_0\sin\theta - g\,t}{v_0\cos\theta}\text{,}
        </md>
        that is, <m>\phi = \arctan\!\left(\dfrac{v_0\sin\theta - g\,t}{v_0\cos\theta}\right)</m>.
      </p>
    </solution>
  </exercise>

  <exercise xml:id="exercise-directrix-freefall">
    <statement>
      <p>
        The <term>directrix</term> of the parabolic path is the horizontal line
        at height <m>\dfrac{v_0^2}{2g}</m> above <m>O</m>. Using the previous
        exercise, show that the speed of the particle at <m>P</m> is equal to the
        speed it would acquire by falling freely from the level of the directrix
        down to <m>P</m>. That is, if <m>h</m> denotes the depth of <m>P</m>
        below the directrix (see <xref ref="fig-velocity-at-P"/>), then
        <m>v^2 = 2\,g\,h</m>.
      </p>
    </statement>
    <solution>
      <p>
        From the previous exercise,
        <md>
          v^2 = v_0^2 - 2\,v_0\,g\,t\sin\theta + g^2 t^2
              = v_0^2 - 2g\!\left(v_0\,t\sin\theta - \tfrac{1}{2}g\,t^2\right)
              = v_0^2 - 2 g y\text{,}
        </md>
        since <m>y = v_0\,t\sin\theta - \tfrac{1}{2}g\,t^2</m> is the height of
        <m>P</m>. Writing this as
        <md>
          v^2 = 2g\!\left(\frac{v_0^2}{2g} - y\right)
        </md>
        and recognizing <m>\dfrac{v_0^2}{2g}</m> as the height of the directrix
        above <m>O</m>, the quantity <m>h = \dfrac{v_0^2}{2g} - y</m> is exactly
        the depth of <m>P</m> below the directrix. Hence <m>v^2 = 2\,g\,h</m>,
        the square of the speed gained by falling freely through the height
        <m>h</m>.
      </p>
    </solution>
  </exercise>
</exercises>
